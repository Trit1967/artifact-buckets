# ---- Required ---------------------------------------------------------------
AB_HOSTNAME=buckets.example.com
# internal: Caddy makes its own certificate. files: put fullchain.pem and privkey.pem in AB_TLS_DIR.
AB_TLS_MODE=internal
AB_TLS_DIR=./deploy/caddy/certs
# Long random strings: openssl rand -hex 32
AB_SECRET_KEY=
POSTGRES_PASSWORD=
# Host folders: the mergerfs pool the app and the share use, and the folder holding one mount per disk.
AB_POOL=/srv/buckets/pool
AB_VOLUMES=/srv/buckets/volumes
AB_STORAGE_MODE=mergerfs
# First admin (local account, for break-glass). Remove the password after AD admins exist.
AB_BOOTSTRAP_ADMIN=admin
AB_BOOTSTRAP_PASSWORD=

# ---- Active Directory (people and groups) -------------------------------------
AB_LDAP_URL=ldaps://dc01.corp.example.com
AB_LDAP_BIND_DN=CN=svc-buckets,OU=Service Accounts,DC=corp,DC=example,DC=com
AB_LDAP_BIND_PASSWORD=
AB_LDAP_BASE_DN=DC=corp,DC=example,DC=com
AB_LDAP_GROUP_PREFIX=AB-
AB_LDAP_ADMIN_GROUP=AB-Admins
AB_LDAP_AUDITOR_GROUP=AB-Auditors
AB_AD_DOMAIN=corp.example.com

# ---- Entra ID sign-in for the browser -----------------------------------------
AB_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
AB_OIDC_CLIENT_ID=
AB_OIDC_CLIENT_SECRET=

# ---- Windows share (docker compose --profile smb) -----------------------------
AB_SMB_ENABLED=true
AB_SMB_HOST=buckets.example.com
AB_SMB_NETBIOS=BUCKETS
AB_AD_REALM=CORP.EXAMPLE.COM
AB_AD_WORKGROUP=CORP
AB_IDMAP_BASE=100000

# ---- Claude Code plugin -------------------------------------------------------
# Empty: the server hands out its own plugin at <base url>/claude/marketplace.json.
AB_PLUGIN_MARKETPLACE=

# Extra https hosts allowed as sign-in redirects (Claude Code itself only needs loopback). Comma-separated.
AB_OAUTH_REDIRECT_HOSTS=
