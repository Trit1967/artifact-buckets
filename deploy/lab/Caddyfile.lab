# Lab: https (Claude Code only signs in over https) on a bare IP address, with a self-signed server
# certificate made by vm-setup.sh. It is not a CA and names only the lab address, so a computer that trusts
# it trusts this server and nothing else. Plain http is kept only to hand out the Claude Code setup files.
{
	admin off
	auto_https disable_redirects
	default_sni {$LAB_IP}
}

https://{$LAB_IP} {
	tls /certs/lab.crt /certs/lab.key
	encode zstd gzip
	request_body {
		max_size 700MB
	}
	reverse_proxy app:8080
	header -Server
}

http:// {
	@installer path /claude/install.ps1 /claude/install.sh /claude/setup.md /claude/ca.crt
	handle @installer {
		reverse_proxy app:8080
	}
	handle {
		redir https://{$LAB_IP}:8443{uri} 308
	}
	header -Server
}
