# Settings for `docker compose up` in this folder (install.sh writes this file for you instead).
# Make secrets with: openssl rand -hex 32

# The address people use, and the same as a URL (add :port when HTTPS isn't on 443).
AB_HOSTNAME=files.example.com
AB_BASE_URL=https://files.example.com
# internal (Caddy's own CA) or an email address for Let's Encrypt.
AB_TLS=internal
AB_HTTPS_PORT=443
AB_HTTP_PORT=80

AB_SECRET_KEY=
POSTGRES_PASSWORD=

# The first admin, created on first start. At least 12 characters.
AB_BOOTSTRAP_ADMIN=admin
AB_BOOTSTRAP_PASSWORD=
AB_BOOTSTRAP_EMAIL=

# The app image: a published one, or built from this repository (docker compose up --build).
AB_IMAGE=artifact-buckets/app:local
AB_SRC=../..
AB_SMB_ENABLED=false
